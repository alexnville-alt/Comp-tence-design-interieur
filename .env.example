# ─────────────────────────────────────────────────────────────
# Copier en .env.local puis renseigner. Ne jamais committer .env*
# Toutes ces variables sont validées au démarrage par
# apps/web/src/lib/env.ts — l'application refuse de démarrer si
# une variable requise manque ou est invalide (échec rapide).
# ─────────────────────────────────────────────────────────────

# Base de données ------------------------------------------------
# Correspond à docker/compose.yml en développement local.
DATABASE_URL="postgresql://atelier:atelier@localhost:5432/atelier?schema=public"

# Authentification -----------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""

# AUTH_URL est FACULTATIF : avec `trustHost: true`, Auth.js déduit l'origine
# des redirections depuis l'hôte de la requête. Ne le renseigner que derrière
# un proxy qui réécrit l'hôte. Le fixer à tort casse toute redirection dès que
# l'application est servie sur un autre port ou domaine (ex. tests E2E).
# AUTH_URL="https://atelier.exemple.fr"

# Sert à construire les liens envoyés par e-mail. Détermine aussi si le cookie
# de session est marqué `Secure` (schéma https).
APP_URL="http://localhost:3000"

# OAuth Google (facultatif — la connexion e-mail fonctionne sans)
# Console Google Cloud → API et services → Identifiants → ID client OAuth
# URI de redirection : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail ---------------------------------------------------------
# MAIL_TRANSPORT=console : les e-mails sont écrits dans la console
# (suffisant en développement — le lien de réinitialisation y est lisible).
MAIL_TRANSPORT="console"
MAIL_FROM="Atelier <bonjour@exemple.fr>"
RESEND_API_KEY=""

# IA (module M5 — non utilisé en M0/M1) --------------------------
# AI_PROVIDER=fake : adaptateur factice, aucun appel réseau, aucun coût.
AI_PROVIDER="fake"
ANTHROPIC_API_KEY=""

# Stockage objet (module M6 — non utilisé en M0/M1) --------------
# Correspond au service MinIO de docker/compose.yml
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="atelier"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Supervision (module M12 — entièrement facultatif) ---------------
# Absentes, aucune des deux ne tente le moindre appel réseau : ni compte
# Sentry ni collecteur OpenTelemetry ne sont fournis avec ce dépôt.
# SENTRY_DSN et NEXT_PUBLIC_SENTRY_DSN sont volontairement distinctes (voir
# apps/web/src/lib/env.ts) : la première n'est lue que côté serveur, la
# seconde est embarquée dans le bundle client — n'y mettre un DSN que si
# l'exposer publiquement est acceptable (c'est le fonctionnement normal du
# SDK JavaScript de Sentry).
# SENTRY_DSN="https://exemplecle@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://exemplecle@o0.ingest.sentry.io/0"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://collecteur.exemple.fr/v1/traces"
