// ─────────────────────────────────────────────────────────────────────────
// Schéma Prisma — Atelier
//
// Périmètre M1+M2+M3+M4+M5+M6+M7+M8+M9 : identité, profil, onboarding,
// curriculum, leçons, exercices notés, évaluations de fin de niveau,
// répétition espacée, atelier 2D, couche IA, analyse photo, bibliothèque,
// générateurs (palettes, moodboards, listes de mobilier) et progression
// (XP, séries, badges, temps réel). Le schéma complet est spécifié dans
// docs/04-modele-de-donnees.md ; il est livré par module. On ne crée pas
// trente tables inutilisées : chaque migration accompagne la fonctionnalité
// qui s'en sert, ce qui garde les migrations relisibles.
//
// M3 n'ajoute PAS XpEvent/Badge/UserBadge/StudySession : le crédit XP réel,
// les séries et les badges sont M9 (gamification). `Lesson.xpReward` et
// `Exercise.xpReward` existent déjà mais ne sont encore crédités nulle part.
//
// M5 ajoute OPEN_CASE à `ExerciseType` (corrigé par l'IA sur le barème de
// docs/06 §1.3) : 8 des 10 types de docs/04 sont maintenant implémentés.
// LAYOUT (dépend du canevas de l'atelier, M4, mais pas encore intégré comme
// type d'exercice de leçon) et CHALLENGE restent exclus — même principe :
// pas d'enum sans code capable de le traiter. Correction par rapport à une
// note laissée ici en M5 : CHALLENGE (défi hebdomadaire) n'est pas de la
// gamification (M9, cette section) mais du contenu — « Défis hebdomadaires »
// figure sous M11 (docs/05 §M11, exécuté en parallèle dès M3), pas M9.
//
// M4 s'écarte de docs/04 §3.6 sur deux points, documentés dans le rapport de
// livraison : pas de `Room.currentVersionId` (la version courante est la
// plus récente par `createdAt` — historique immotable, « restaurer » ajoute
// une version plutôt que de réécrire un pointeur) ; pas de `Room.areaM2` ni
// de `RoomVersion.previewAssetId` (calculés/générés, pas stockés). `Asset`
// existe depuis M6, mais seulement pour les photos téléversées à analyser —
// générer et stocker un aperçu de scène reste un besoin distinct, non traité.
// `JournalEntry` reste hors périmètre (M10) ; `Moodboard` arrive en M8.
//
// M7 ajoute `LibraryItem`/`LibraryRelation`/`Favorite` (bibliothèque). Deux
// écarts documentés dans le rapport de livraison : `imageAssetId` (docs/04
// §3.8) n'est pas encore rempli — aucune fiche de ce module n'a d'image
// associée, faute de pipeline de génération/curation visuelle en périmètre
// M7 ; `vector(1536)` de docs/04 devient `vector(1024)` (ADR-0013, choix du
// fournisseur d'embeddings fait après l'écriture de docs/04).
//
// M8 ajoute `Moodboard`/`MoodboardItem` (docs/04 §3.10), en corrigeant deux
// relations que le brouillon docs/04 laissait implicites : `Moodboard.roomId`
// et `MoodboardItem.assetId` deviennent de vraies clés étrangères (`Room?`,
// `Asset?`), pas de simples colonnes `String?` sans contrainte — cohérent
// avec `MoodboardItem.libraryItemId`, qui en avait déjà une dans le
// brouillon. Aucune table `Palette` séparée : une palette générée est un
// `Moodboard` dont les items portent `colorHex` sans `libraryItemId` — pas
// une donnée de nature différente, juste des items sans image.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector (M7, ADR-0013) — géré par Prisma comme le reste du schéma
  // plutôt qu'un script SQL séparé, pour que la migration reste rejouable
  // avec les mêmes outils que tout le reste (`prisma migrate deploy`).
  extensions = [vector]
}

// ── Identité ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  /// Haché en Argon2id. `null` pour un compte créé uniquement via OAuth.
  passwordHash String?

  role Role @default(LEARNER)

  /// Compteur de révocation de session (ADR-0012).
  /// Chaque jeton émis embarque la valeur courante ; le rejeton est refusé dès
  /// qu'elle change. Incrémenter ce champ déconnecte immédiatement toutes les
  /// sessions, sur tous les appareils — c'est ce qui remplace la révocation
  /// qu'offraient les sessions en base.
  sessionVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Suppression logique : l'utilisateur disparaît immédiatement de
  /// l'application, la purge physique est différée (RGPD, AUTH-04).
  deletedAt DateTime?

  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  lessonProgress      LessonProgress[]
  levelProgress       LevelProgress[]
  submissions         Submission[]
  cardReviews         CardReview[]
  projects            Project[]
  conversations       AiConversation[]
  aiUsage             AiUsage[]
  assets              Asset[]
  favorites           Favorite[]
  xpEvents            XpEvent[]
  badges              UserBadge[]
  studySessions       StudySession[]

  @@index([deletedAt])
}

enum Role {
  LEARNER
  ADMIN
}

// ── Modèles requis par Auth.js v5 (adaptateur Prisma) ────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Conservé bien que la stratégie de session soit `jwt` (ADR-0012) :
/// l'adaptateur Prisma en a besoin, et le modèle reste en place pour un
/// éventuel retour aux sessions en base sans migration destructive.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Profil et préférences ────────────────────────────────────────────────

model Profile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding (AUTH-02) — alimente les recommandations
  goal          Goal     @default(WHOLE_HOME)
  housingType   Housing?
  weeklyMinutes Int      @default(150)
  startingLevel Int      @default(1)

  // Préférences (AUTH-03)
  theme         Theme   @default(SYSTEM)
  locale        String  @default("fr")
  reducedMotion Boolean @default(false)
  soundEnabled  Boolean @default(false)

  // Compteurs dénormalisés — lus à chaque affichage du tableau de bord.
  // Recalculables depuis l'historique : voir docs/04 §3.1.
  totalXp        Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  streakFreezes  Int       @default(1)

  aiMonthlyQuota Int @default(200)

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Goal {
  WHOLE_HOME
  SINGLE_ROOM
  CAREER
  CURIOSITY
}

enum Housing {
  HOUSE
  APARTMENT
  STUDIO
  OTHER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ── Réinitialisation de mot de passe ─────────────────────────────────────

/// Le jeton est stocké **haché** (SHA-256) : une fuite de la base ne permet
/// donc pas de prendre la main sur un compte. Usage unique, expiration 1 h.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ── Curriculum et leçons (M2) ─────────────────────────────────────────────

/// Matérialise la structure des 15 niveaux définie dans
/// `@atelier/domain` (packages/domain/src/curriculum/levels.ts), qui reste la
/// source de vérité pour le titre, la phase et l'ordre — la synchronisation
/// de contenu (apps/web/scripts/sync-content.ts) fait un upsert par
/// `number`. `published` et `passingScore` sont en revanche des propriétés
/// propres à la base : la structure des 15 niveaux est toujours visible
/// (LEARN-01), `published` ne concerne ici que la présence de contenu réel.
model Level {
  id               String  @id @default(cuid())
  number           Int     @unique
  slug             String  @unique
  title            String
  summary          String
  phase            Int
  estimatedMinutes Int
  requiresLevel    Int?
  /// Recopié depuis `Assessment.passingScore` à la synchronisation, pour
  /// afficher le seuil de réussite sur la carte de parcours sans jointure.
  passingScore     Int     @default(70)
  published        Boolean @default(true)

  chapters      Chapter[]
  /// Un seul fichier `_evaluation.yaml` par niveau (simplification M3 assumée
  /// par rapport à docs/04, qui n'exclut pas plusieurs évaluations —
  /// `levelId` est donc rendu unique ici, pas seulement indexé).
  assessment    Assessment?
  levelProgress LevelProgress[]

  @@index([phase, number])
}

/// Groupement thématique de leçons au sein d'un niveau. Sa métadonnée vit
/// dans un fichier `_chapitre.yaml` à côté des leçons (voir ADR-0010) plutôt
/// que d'être répétée dans le frontmatter de chaque leçon, pour éviter toute
/// divergence de titre entre deux leçons d'un même chapitre.
model Chapter {
  id      String @id @default(cuid())
  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  number  Int
  slug    String
  title   String

  lessons Lesson[]

  @@unique([levelId, number])
  @@unique([levelId, slug])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  /// Slug global (pas seulement unique dans son chapitre) : il apparaît seul
  /// dans certains liens internes (favoris, historique) où le chemin complet
  /// niveau/chapitre n'est pas disponible.
  slug      String  @unique
  title     String
  summary   String
  minutes   Int
  xpReward  Int     @default(20)

  /// Nombre de blocs pédagogiques (Texte, Schema, ErreurFrequente…) que
  /// contient la leçon. Calculé à la synchronisation à partir de la
  /// numérotation explicite `n={N}` des blocs MDX — voir
  /// apps/web/src/lib/content/blocks.ts. Sert de dénominateur à la
  /// progression (« 3/7 ») et à valider que `LessonProgress.blockIndex` reste
  /// dans les bornes.
  blockCount Int

  /// SHA-256 du fichier source. Ne sert à rien fonctionnellement en M2 ;
  /// permet de détecter en un coup d'œil (`prisma studio`, requête) qu'un
  /// contenu a changé depuis la dernière synchronisation.
  contentHash String

  /// Structure prête, contenu vide en V1 (LEARN-03) — le bloc EmplacementVideo
  /// affiche un état « à venir » tant que ce champ est `null`.
  videoUrl  String?
  published Boolean @default(true)

  progress  LessonProgress[]
  exercises Exercise[]
  cards     Card[]

  @@unique([chapterId, number])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status      ProgressStatus @default(NOT_STARTED)
  /// Numéro du bloc le plus avancé que l'utilisateur a lu, jamais décroissant
  /// (voir features/learning/progress-actions.ts : le serveur applique un
  /// maximum avec la valeur existante, pour rester correct même si deux
  /// onglets envoient des mises à jour dans le désordre).
  blockIndex  Int            @default(0)
  /// Alimenté à partir de M9 (mesure par heartbeat, PROG-05). La colonne
  /// existe dès maintenant : aucune migration à prévoir quand M9 l'utilisera.
  timeSpentMs Int            @default(0)

  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, status])
}

// ── Exercices, évaluations et progression de niveau (M3) ──────────────────

/// 7 des 10 types de docs/04 — voir la note de périmètre en tête de fichier.
enum ExerciseType {
  QUIZ_MCQ
  QUIZ_TRUE_FALSE
  QUIZ_MATCH
  QUIZ_ORDER
  HOTSPOT
  PALETTE
  MATERIAL_CHOICE
  /// Cas pratique ouvert, corrigé par l'IA sur le barème de docs/06 §1.3
  /// (M5) — hors du `ExerciseFrontmatterSchema` à discriminant de
  /// `packages/domain` (schéma et correction séparés, voir ce paquet).
  OPEN_CASE
}

/// Un exercice est attaché à une leçon (pratique immédiate) OU à une
/// évaluation de fin de niveau — jamais aux deux, jamais à aucune. Le script
/// de synchronisation garantit cet invariant ; rien ne l'exprime en
/// contrainte SQL (Prisma ne modélise pas les contraintes XOR).
model Exercise {
  id           String      @id @default(cuid())
  lessonId     String?
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Slug stable, clé d'upsert du script de synchronisation (ADR-0010) —
  /// absent de docs/04, ajouté pour la même raison que `Lesson.contentHash`
  /// en M2 : republier le même contenu ne doit jamais dupliquer une ligne.
  slug     String
  type     ExerciseType
  prompt   String
  /// Le reste du frontmatter validé par `ExerciseFrontmatterSchema`
  /// (choices, correctIndices, zones… selon `type`), hors slug/type/prompt.
  payload  Json
  maxScore Int          @default(100)
  xpReward Int          @default(10)
  order    Int          @default(0)

  submissions Submission[]

  @@unique([lessonId, slug])
  @@unique([assessmentId, slug])
}

model Submission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  /// Réponse brute de l'utilisateur, dans la forme attendue par
  /// `AnswerSchemas[exercise.type]` (packages/domain/src/exercises/grading.ts).
  answer      Json
  /// `score`/`correct` sont calculés côté serveur par `gradeExercise` — jamais
  /// acceptés depuis le client (voir features/exercises/actions.ts).
  score       Int
  scoreRatio  Float
  correct     Boolean
  gradedBy    GradedBy @default(AUTO)
  /// Retour structuré de la correction IA (OPEN_CASE uniquement) : deux
  /// points forts nommés, deux axes d'amélioration actionnables, la règle à
  /// réviser — voir `GradingFeedbackSchema` (packages/domain). `null` pour
  /// les 7 types corrigés automatiquement, où l'explication vient du
  /// frontmatter de l'exercice, pas de la soumission.
  feedback    Json?
  attempt     Int      @default(1)
  timeSpentMs Int?
  createdAt   DateTime @default(now())

  @@index([userId, exerciseId])
}

enum GradedBy {
  AUTO
  AI
}

model Assessment {
  id           String     @id @default(cuid())
  levelId      String     @unique
  level        Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int        @default(70)
  exercises    Exercise[]
}

model LevelProgress {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  unlockedAt  DateTime?
  completedAt DateTime?
  bestScore   Int?

  @@unique([userId, levelId])
}

// ── Répétition espacée — FSRS-6 (M3, ADR-0007) ─────────────────────────────

/// Générée automatiquement depuis le frontmatter d'une leçon (`cards:`) — il
/// n'existe aucune autre façon d'en créer une, la leçon qui la justifie reste
/// donc toujours la source de vérité (docs/05 M3).
model Card {
  id       String  @id @default(cuid())
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  /// Clé d'upsert du script de synchronisation — absente de docs/04, même
  /// raison que `Exercise.slug`.
  slug  String  @unique
  front String
  back  String
  hint  String?
  /// Thème libre ("couleur", "eclairage"…), utilisé plus tard pour cibler les
  /// points faibles d'un apprenant.
  topic String

  reviews CardReview[]

  @@index([topic])
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// État FSRS-6 par (utilisateur, carte). Voir ADR-0007 et
/// packages/domain/src/srs/fsrs.ts, qui calcule les transitions ci-dessous —
/// ce modèle ne fait que persister leur résultat.
model CardReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  stability    Float
  difficulty   Float
  dueAt        DateTime
  lastReviewAt DateTime?
  reps         Int       @default(0)
  lapses       Int       @default(0)
  state        CardState @default(NEW)
  /// 1 À revoir · 2 Difficile · 3 Correct · 4 Facile
  lastRating   Int?

  @@unique([userId, cardId])
  @@index([userId, dueAt]) // ← requête la plus fréquente de l'application (ADR-0007)
}

// ── Projets et atelier (M4) ────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ProjectKind   @default(PERSONAL)
  name        String
  description String?
  housingType Housing?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rooms      Room[]
  moodboards Moodboard[]

  @@index([userId, kind])
}

enum ProjectKind {
  PERSONAL
  EXERCISE
  TEMPLATE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Room {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        RoomType
  ceilingCm   Int          @default(250)
  orientation Orientation?
  status      RoomStatus   @default(TO_DESIGN)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  versions   RoomVersion[]
  moodboards Moodboard[]

  @@index([projectId])
}

enum RoomType {
  KITCHEN
  BATHROOM
  LIVING
  BEDROOM
  OFFICE
  HALL
  OUTDOOR
  OTHER
}

enum RoomStatus {
  TO_MEASURE
  TO_DESIGN
  IN_PROGRESS
  VALIDATED
  DONE
}

enum Orientation {
  N
  NE
  E
  SE
  S
  SW
  W
  NW
}

/// Une version = un instantané complet et autonome de la pièce (SIM-09) : la
/// duplication et la restauration sont de simples copies de ligne, jamais une
/// réécriture en place. La version courante est la plus récente par
/// `createdAt` — voir la note en tête de fichier.
model RoomVersion {
  id     String  @id @default(cuid())
  roomId String
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label  String
  notes  String?

  /// Scène complète validée par SceneSchema (Zod, `@atelier/domain`) :
  /// { walls[], openings[], furniture[], finishes{}, lighting[] }.
  sceneData    Json
  sceneVersion Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([roomId, createdAt])
}

// ── Couche IA (M5, docs/04 §3.9) ─────────────────────────────────────────

/// Un fil de discussion avec l'assistant (AI-01). `context` ancre la
/// conversation à ce qu'affichait l'apprenant en l'ouvrant — jamais
/// interpolé dans le prompt système de `@atelier/ai` (ADR-0005) : seul le
/// contenu des `AiMessage` sert de contexte variable envoyé au fournisseur.
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  /// Ancrage : { lessonId?, roomVersionId?, projectId?, libraryItemId? }
  context   Json?
  createdAt DateTime    @default(now())
  messages  AiMessage[]

  @@index([userId, createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String
  /// Fiches bibliothèque citées (AI-08) — traçabilité des affirmations.
  /// `null` avant M7 : rien à citer tant qu'il n'existe pas de bibliothèque.
  citations      Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Un enregistrement par appel au fournisseur IA (succès ou échec) : quotas,
/// coûts, diagnostic de performance (docs/02 §5.6). Écrit après chaque appel,
/// jamais mis à jour — c'est la table qu'interroge `Profile.aiMonthlyQuota`
/// avant d'autoriser un nouvel appel (M5 tâche « quotas et coûts »).
model AiUsage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AiFeature
  model        String
  inputTokens  Int
  outputTokens Int
  cachedTokens Int       @default(0)
  /// Coût en centimes d'euro — un entier évite l'arithmétique flottante sur
  /// une donnée comptable (même choix que les montants ailleurs dans docs/04).
  costCents    Int
  durationMs   Int
  success      Boolean   @default(true)
  errorCode    String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

enum AiFeature {
  CHAT
  PHOTO_ANALYSIS
  GRADING
  GENERATOR
  CRITIQUE
}

// ── Fichiers et analyse photo (M6, docs/04 §3.7, ADR-0008) ────────────────

/// `ProjectAsset` (rattachement d'un fichier à un projet avec calibrage
/// d'échelle pour les plans importés, docs/04 §3.7) reste hors périmètre M6 :
/// c'est un besoin du plan importé (PROJ-02), pas de la photo analysée —
/// même principe que les exclusions précédentes (pas de modèle sans code qui
/// le remplit).
model Asset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AssetKind
  /// Clé S3 — jamais une URL publique (ADR-0008).
  storageKey String    @unique
  mimeType   String
  bytes      Int
  width      Int?
  height     Int?
  /// Déduplication + cache d'analyse (ADR-0008) : réanalyser la même image
  /// ne déclenche aucun appel IA.
  sha256     String
  createdAt  DateTime  @default(now())

  analyses      PhotoAnalysis[]
  moodboardItems MoodboardItem[]

  @@index([userId, kind])
  @@index([sha256])
}

/// Un seul type utilisé pour l'instant. FLOOR_PLAN et INSPIRATION (M10),
/// PREVIEW (rattrapage du tradeoff M4 sur `RoomVersion.previewAssetId`) et
/// AVATAR arriveront avec le code qui les traite — même principe que
/// `ExerciseType.OPEN_CASE` en M5 : pas de valeur d'enum sans utilisateur.
enum AssetKind {
  ROOM_PHOTO
}

model PhotoAnalysis {
  id      String  @id @default(cuid())
  assetId String
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Référence souple vers une pièce de l'atelier, pas une clé étrangère
  /// (docs/04 §3.7) : une analyse reste consultable même si la pièce qu'elle
  /// décrivait a depuis été supprimée dans l'atelier.
  roomId  String?

  /// Conforme à `AnalysePhotoSchema` (Zod, `@atelier/domain`).
  result        Json
  model         String
  /// Rejouabilité : quel prompt a produit ce résultat (docs/04 §3.7).
  promptVersion String
  costCents     Int
  createdAt     DateTime @default(now())

  @@index([assetId, createdAt])
  @@index([roomId, createdAt])
}

// ── Bibliothèque (M7, docs/04 §3.8, ADR-0013) ──────────────────────────────

/// Une table, un discriminant `category`, des attributs typés en JSONB
/// (docs/04 §1.3) : les champs communs — description, avantages,
/// inconvénients, budget, entretien — portent l'essentiel de la valeur
/// pédagogique et sont en colonnes réelles (filtrables) ; le spécifique à la
/// catégorie (dureté d'un bois, lumens d'un luminaire) va en JSONB, validé
/// par `LibraryItemFrontmatterSchema` (`@atelier/domain`) à la
/// synchronisation, jamais par une contrainte de base.
model LibraryItem {
  id          String      @id @default(cuid())
  slug        String      @unique
  category    LibCategory
  name        String
  summary     String

  description   String
  pros          String[]
  cons          String[]
  budgetTier    BudgetTier
  /// Toujours formulé en « ordre de grandeur » — jamais un prix ferme.
  budgetNote    String?
  maintenance   String
  mistakes      String[]
  bestFor       RoomType[]
  /// Slugs de `LibraryItem` de catégorie STYLE — pas de clé étrangère : une
  /// fiche peut citer un style avant qu'il ne soit synchronisé dans le même
  /// lot (`content:sync` valide l'existence après coup, comme les relations).
  styles        String[]
  noWorksNeeded Boolean     @default(false)

  attributes Json

  /// Rempli par un pipeline de génération/curation visuelle qui n'existe pas
  /// encore (docs/04 §3.8) : aucune fiche M7 n'en a. `imageAssetId` référence
  /// un `Asset`, pas une URL — même principe de confidentialité qu'ADR-0008.
  imageAssetId String?

  /// Recherche plein texte française (docs/05 M7). Colonne générée par
  /// PostgreSQL (`GENERATED ALWAYS AS`, voir la migration) à partir de
  /// `name`/`summary`/`description`/`pros`/`cons`/`mistakes` — jamais écrite
  /// par Prisma ni par l'application, donc toujours synchronisée avec les
  /// champs source.
  searchVector Unsupported("tsvector")?

  /// Ancrage documentaire (RAG, docs/02 §5.5, ADR-0013). `vector(1024)` —
  /// Voyage AI `voyage-3.5`, pas 1536 (docs/04 §3.8 était antérieur au choix
  /// du fournisseur). Calculé et écrit par `content:sync` via `$executeRaw`
  /// (Prisma ne sait pas écrire un type `Unsupported`).
  embedding Unsupported("vector(1024)")?

  relationsFrom  LibraryRelation[] @relation("from")
  relationsTo    LibraryRelation[] @relation("to")
  favorites      Favorite[]
  moodboardItems MoodboardItem[]

  @@index([category])
  @@index([budgetTier])
}

enum LibCategory {
  STYLE
  MATERIAL
  COLOR
  WOOD
  STONE
  FLOORING
  WALL_COVERING
  LIGHTING
  SOFA
  TABLE
  CHAIR
  STORAGE
  KITCHEN
  BATHROOM
  STAIRCASE
  TEXTILE
  PLANT
  ACCESSORY
}

enum BudgetTier {
  ECONOMY
  MID
  PREMIUM
  LUXURY
}

/// LIB-04 — le graphe d'associations est ce qui rend la bibliothèque utile :
/// il permet à l'IA de justifier « ce carrelage s'accorde avec ce bois ».
/// Déclarées par slug dans le frontmatter de la fiche source
/// (`packages/domain/src/library/schema.ts`) ; cohérence bidirectionnelle
/// vérifiée à la synchronisation (`checkRelationSymmetry`), pas en base —
/// une réciproque manquante est une erreur de contenu, détectée avant que la
/// donnée n'existe, pas après.
model LibraryRelation {
  id     String       @id @default(cuid())
  fromId String
  from   LibraryItem  @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     LibraryItem  @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  type   RelationType
  note   String?

  @@unique([fromId, toId, type])
}

enum RelationType {
  PAIRS_WITH
  AVOID_WITH
  CHEAPER_ALT
  PREMIUM_ALT
  SAME_FAMILY
}

model Favorite {
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// « default » si l'utilisateur ne crée jamais de collection nommée — la
  /// fonctionnalité « collections » n'impose donc rien à qui veut juste un
  /// bouton « favori » simple (docs/05 M7).
  collection String      @default("default")
  createdAt  DateTime    @default(now())

  @@id([userId, itemId, collection])
  @@index([userId, collection])
}

// ── Générateurs (M8, docs/04 §3.10) ────────────────────────────────────────

/// Un plateau libre de planche d'inspiration — palette de couleurs, matériaux,
/// éclairage, accessoires, végétaux. Généré par l'IA à partir de candidats
/// réels de la bibliothèque (jamais de fiche inventée, `@atelier/domain`),
/// puis librement réédité (position/taille/rotation de chaque item).
model Moodboard {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Facultatif : un moodboard peut naître d'une pièce précise de l'atelier
  /// (palette/mobilier pensés pour elle) ou rester libre (exploration de
  /// style avant tout projet de pièce).
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MoodboardItem[]

  @@index([projectId])
  @@index([roomId])
}

/// `libraryItemId` et `colorHex` sont mutuellement significatifs mais tous
/// deux facultatifs au niveau du schéma (pas de contrainte `CHECK` Prisma) :
/// un item couleur de palette n'a pas de fiche, un item bibliothèque n'a pas
/// de couleur propre. Validé côté application, pas en base — même choix que
/// `attributes` de `LibraryItem` (docs/05 M7).
model MoodboardItem {
  id            String       @id @default(cuid())
  moodboardId   String
  moodboard     Moodboard    @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  libraryItemId String?
  libraryItem   LibraryItem? @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  /// Vignette de la fiche liée, si elle en a une — jamais une URL directe
  /// (ADR-0008) : toujours re-présignée à l'affichage.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// Uniquement pour un item de palette (pas de `libraryItemId`).
  colorHex String?
  label    String?
  /// Position/taille/rotation dans l'espace logique du plateau (1600×1200
  /// unités, indépendant du pixel écran — voir `packages/domain/src/generators`),
  /// validées par `MoodboardTransformSchema` avant écriture (`{x,y,w,h,z,rotation}`).
  transform Json
  createdAt DateTime @default(now())

  @@index([moodboardId])
}

// ── Progression et gamification (M9, docs/04 §3.1/3.4) ──────────────────────

/// Historique append-only des gains de XP — jamais modifié ni supprimé après
/// écriture, source de vérité derrière `Profile.totalXp` (compteur
/// dénormalisé, recalculable depuis cette table).
model XpEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  reason XpReason
  /// Leçon, exercice ou évaluation à l'origine du gain — facultatif (ex. STREAK
  /// n'a pas de ressource à référencer).
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Réduit par rapport à `docs/04` §3.4 (`LESSON QUIZ EXERCISE REVIEW
/// ASSESSMENT PROJECT STREAK CHALLENGE`) : `QUIZ` est fusionné dans
/// `EXERCISE` (aucun code ne distingue un exercice de type quiz d'un autre —
/// tous passent par `submitExerciseAction`, une seule raison suffit) ;
/// `PROJECT` (M10) et `CHALLENGE` (défis hebdomadaires, M11) restent exclus —
/// même principe que `ExerciseType` plus haut : pas d'enum sans code capable
/// de le traiter.
enum XpReason {
  LESSON
  EXERCISE
  REVIEW
  ASSESSMENT
  STREAK
}

/// Règle déclarative, évaluée par `packages/domain` (`evaluateBadge`) contre
/// un contexte agrégé côté serveur (série courante, niveaux terminés,
/// compteurs nommés) — jamais par une requête ad hoc par badge, pour que
/// débloquer un nouveau badge se limite à ajouter une entrée ici.
model Badge {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  /// Nom d'icône `lucide-react` (`apps/web`) — pas d'image dédiée, même
  /// raisonnement que `LibraryItem.imageAssetId` (M7) : aucun pipeline de
  /// curation visuelle en périmètre.
  icon String
  /// `{ type: "streak", days } | { type: "level_complete", level } |
  /// { type: "count", metric, gte }` — voir `BadgeCriteriaSchema`
  /// (`@atelier/domain`).
  criteria Json
  users    UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

/// Temps réel passé, alimenté par heartbeat toutes les 30 s (PROG-05) — pas
/// la durée depuis l'ouverture de l'onglet : le client n'envoie un battement
/// que pendant que la page est visible et au premier plan (`document.visibilityState`),
/// donc un onglet oublié en arrière-plan n'accumule rien.
model StudySession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  activeMs  Int       @default(0)
  /// "lesson:<id>" | "studio" | "review" — contexte libre, jamais interrogé
  /// par égalité stricte, seulement affiché.
  context String?

  @@index([userId, startedAt])
}
