// ─────────────────────────────────────────────────────────────────────────
// Schéma Prisma — Atelier
//
// Périmètre M1+M2 : identité, profil, onboarding, curriculum et leçons.
// Le schéma complet est spécifié dans docs/04-modele-de-donnees.md ; il est
// livré par module (M3 apporte le SRS, M4 l'atelier…).
// On ne crée pas trente tables inutilisées : chaque migration accompagne la
// fonctionnalité qui s'en sert, ce qui garde les migrations relisibles.
//
// M2 n'ajoute PAS Exercise/Card/Assessment/LevelProgress : la notation, les
// cartes mémoire et le déverrouillage par évaluation sont M3. Un niveau reste
// donc « déverrouillé » selon le seul diagnostic de M1 (packages/domain,
// isLevelUnlocked) jusqu'à ce que M3 introduise un vrai critère de réussite.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identité ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  /// Haché en Argon2id. `null` pour un compte créé uniquement via OAuth.
  passwordHash String?

  role Role @default(LEARNER)

  /// Compteur de révocation de session (ADR-0012).
  /// Chaque jeton émis embarque la valeur courante ; le rejeton est refusé dès
  /// qu'elle change. Incrémenter ce champ déconnecte immédiatement toutes les
  /// sessions, sur tous les appareils — c'est ce qui remplace la révocation
  /// qu'offraient les sessions en base.
  sessionVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Suppression logique : l'utilisateur disparaît immédiatement de
  /// l'application, la purge physique est différée (RGPD, AUTH-04).
  deletedAt DateTime?

  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  lessonProgress      LessonProgress[]

  @@index([deletedAt])
}

enum Role {
  LEARNER
  ADMIN
}

// ── Modèles requis par Auth.js v5 (adaptateur Prisma) ────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Conservé bien que la stratégie de session soit `jwt` (ADR-0012) :
/// l'adaptateur Prisma en a besoin, et le modèle reste en place pour un
/// éventuel retour aux sessions en base sans migration destructive.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Profil et préférences ────────────────────────────────────────────────

model Profile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding (AUTH-02) — alimente les recommandations
  goal          Goal     @default(WHOLE_HOME)
  housingType   Housing?
  weeklyMinutes Int      @default(150)
  startingLevel Int      @default(1)

  // Préférences (AUTH-03)
  theme         Theme   @default(SYSTEM)
  locale        String  @default("fr")
  reducedMotion Boolean @default(false)
  soundEnabled  Boolean @default(false)

  // Compteurs dénormalisés — lus à chaque affichage du tableau de bord.
  // Recalculables depuis l'historique : voir docs/04 §3.1.
  totalXp        Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  streakFreezes  Int       @default(1)

  aiMonthlyQuota Int @default(200)

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Goal {
  WHOLE_HOME
  SINGLE_ROOM
  CAREER
  CURIOSITY
}

enum Housing {
  HOUSE
  APARTMENT
  STUDIO
  OTHER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ── Réinitialisation de mot de passe ─────────────────────────────────────

/// Le jeton est stocké **haché** (SHA-256) : une fuite de la base ne permet
/// donc pas de prendre la main sur un compte. Usage unique, expiration 1 h.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ── Curriculum et leçons (M2) ─────────────────────────────────────────────

/// Matérialise la structure des 15 niveaux définie dans
/// `@atelier/domain` (packages/domain/src/curriculum/levels.ts), qui reste la
/// source de vérité pour le titre, la phase et l'ordre — la synchronisation
/// de contenu (apps/web/scripts/sync-content.ts) fait un upsert par
/// `number`. `published` et `passingScore` sont en revanche des propriétés
/// propres à la base : la structure des 15 niveaux est toujours visible
/// (LEARN-01), `published` ne concerne ici que la présence de contenu réel.
model Level {
  id               String  @id @default(cuid())
  number           Int     @unique
  slug             String  @unique
  title            String
  summary          String
  phase            Int
  estimatedMinutes Int
  requiresLevel    Int?
  /// Utilisé à partir de M3 (évaluation de fin de niveau) — la colonne existe
  /// dès maintenant pour éviter une migration supplémentaire au module M3.
  passingScore     Int     @default(70)
  published        Boolean @default(true)

  chapters Chapter[]

  @@index([phase, number])
}

/// Groupement thématique de leçons au sein d'un niveau. Sa métadonnée vit
/// dans un fichier `_chapitre.yaml` à côté des leçons (voir ADR-0010) plutôt
/// que d'être répétée dans le frontmatter de chaque leçon, pour éviter toute
/// divergence de titre entre deux leçons d'un même chapitre.
model Chapter {
  id      String @id @default(cuid())
  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  number  Int
  slug    String
  title   String

  lessons Lesson[]

  @@unique([levelId, number])
  @@unique([levelId, slug])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  /// Slug global (pas seulement unique dans son chapitre) : il apparaît seul
  /// dans certains liens internes (favoris, historique) où le chemin complet
  /// niveau/chapitre n'est pas disponible.
  slug      String  @unique
  title     String
  summary   String
  minutes   Int
  xpReward  Int     @default(20)

  /// Nombre de blocs pédagogiques (Texte, Schema, ErreurFrequente…) que
  /// contient la leçon. Calculé à la synchronisation à partir de la
  /// numérotation explicite `n={N}` des blocs MDX — voir
  /// apps/web/src/lib/content/blocks.ts. Sert de dénominateur à la
  /// progression (« 3/7 ») et à valider que `LessonProgress.blockIndex` reste
  /// dans les bornes.
  blockCount Int

  /// SHA-256 du fichier source. Ne sert à rien fonctionnellement en M2 ;
  /// permet de détecter en un coup d'œil (`prisma studio`, requête) qu'un
  /// contenu a changé depuis la dernière synchronisation.
  contentHash String

  /// Structure prête, contenu vide en V1 (LEARN-03) — le bloc EmplacementVideo
  /// affiche un état « à venir » tant que ce champ est `null`.
  videoUrl  String?
  published Boolean @default(true)

  progress LessonProgress[]

  @@unique([chapterId, number])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status ProgressStatus @default(NOT_STARTED)
  /// Numéro du bloc le plus avancé que l'utilisateur a lu, jamais décroissant
  /// (voir features/learning/progress-actions.ts : le serveur applique un
  /// maximum avec la valeur existante, pour rester correct même si deux
  /// onglets envoient des mises à jour dans le désordre).
  blockIndex Int @default(0)
  /// Alimenté à partir de M9 (mesure par heartbeat, PROG-05). La colonne
  /// existe dès maintenant : aucune migration à prévoir quand M9 l'utilisera.
  timeSpentMs Int @default(0)

  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, status])
}
